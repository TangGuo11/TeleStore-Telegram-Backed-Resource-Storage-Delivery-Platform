# Copy this file to .env and fill in your own values.
# Never commit real credentials.

NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
INTERNAL_API_TOKEN=change-me-internal-token

# MongoDB (use local Mongo or your own Atlas cluster)
USER_DB_URI=mongodb://127.0.0.1:27017/zylm_user
CHAT_DB_URI=mongodb://127.0.0.1:27017/zylm_chat
TELEGRAM_DB_URI=mongodb://127.0.0.1:27017/zylm_telegram
TEST_DB_URI=mongodb://127.0.0.1:27017/zylm_daily
MONGO_URI=mongodb://127.0.0.1:27017/zylm_daily
YY_DB_URI=mongodb://127.0.0.1:27017/zylm_works
YX_DB_URI=mongodb://127.0.0.1:27017/zylm_game
MEMBER_DB_URI=mongodb://127.0.0.1:27017/zylm_member
MONGODB_URI=mongodb://127.0.0.1:27017/zylm_order
ORDER_DB_URI=mongodb://127.0.0.1:27017/zylm_order

# Telegram
BOT_TOKEN=your-telegram-bot-token
FILE_BOT_TOKEN=your-file-bot-token
TDLIGHT_URL=http://127.0.0.1:8081
CACHE_DIR=./downloads
FORWARD_BOT_DIR=

# Public site URL used in payment callbacks
BASE_URL=http://localhost:3000
GAME_SHOP_URL=http://localhost:3001
GAME_DOMAIN_FILE=./cloudflared/game-domain.txt
PUBLIC_DIR=./public
DOMAIN_DIR=./cloudflared
IPV6_LOG_PATH=./ipv6-log.txt

# Payment gateway
IDATARIVER_SECRET=your-payment-api-secret
IDATARIVER_BASE_URL=https://api.idatariver.com

# Optional Redis
# REDIS_URL=redis://127.0.0.1:6379

# Telegram channel / group IDs (placeholders)
YY_CHAT_ID=-1000000000001
YX_CHAT_ID=-1000000000002
DAILY_UPDATE_CHAT_ID=-1000000000003
DAILY_GOSSIP_CHAT_ID=-1000000000004
DAILY_BEST_CHAT_ID=-1000000000005
TELEGRAM_FEED_CHAT_ID=-1000000000006
GAME_FORWARD_CHAT_ID=-1000000000007
MEMBER_CHAT_ID_1=-1000000000011
MEMBER_CHAT_ID_2=-1000000000012
MEMBER_CHAT_ID_3=-1000000000013
MEMBER_CHAT_ID_4=-1000000000014
MEMBER_CHAT_ID_5=-1000000000015
