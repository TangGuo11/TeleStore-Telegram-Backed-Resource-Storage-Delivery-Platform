# Game shop / game API environment
# Copy to yx/.env and fill in your own values.

GAME_STORAGE_DIR=./downloads/yx
GAME_API_PORT=3001
BOT_TOKEN=your-game-bot-token
MONGO_URL=mongodb://127.0.0.1:27017/zylm_game
TDLIGHT_URL=http://127.0.0.1:8081
TDLIGHT_BASE_DIR=./downloads/tdlight
ORDER_DB_URI=mongodb://127.0.0.1:27017/zylm_order
USER_DB_URI=mongodb://127.0.0.1:27017/zylm_user
IDATARIVER_SECRET=your-payment-api-secret
IDATARIVER_BASE_URL=https://api.idatariver.com
BASE_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
INTERNAL_API_TOKEN=change-me-internal-token
PUBLIC_DIR=./public
GAME_FORWARD_CHAT_ID=-1000000000007
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
